# Copy this file to `.env` for local (non-Docker) development.
# `.env` itself is git-ignored — never commit real secrets.
# docker-compose.yml sets its own environment block and does not read this
# file, but the variable names below match exactly.

NODE_ENV=development
PORT=3000

# --- Database ---------------------------------------------------------
# sqlite3 = zero-setup quick start (see README). pg = the Docker/Postgres path.
DB_CLIENT=sqlite3
SQLITE_FILE=./data/dev.sqlite3

# Only read when DB_CLIENT=pg:
# DATABASE_URL=postgres://widgetplatform:widgetplatform@localhost:5432/widgetplatform
PGHOST=localhost
PGPORT=5432
PGUSER=widgetplatform
PGPASSWORD=widgetplatform
PGDATABASE=widgetplatform

# --- Auth --------------------------------------------------------------
# Generate a real one for anything beyond local dev, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=12h

# --- CORS ----------------------------------------------------------
# Origin allowed to call the authenticated dashboard/admin API.
# The public widget config/submission endpoints are always open to any
# origin by design (see src/middleware/cors.js) and are not controlled here.
ADMIN_ORIGIN=*

# --- Rate limiting -------------------------------------------------
RATE_LIMIT_PER_IP_WINDOW_MS=60000
RATE_LIMIT_PER_IP_MAX=20
RATE_LIMIT_PER_WIDGET_WINDOW_MS=60000
RATE_LIMIT_PER_WIDGET_MAX=60

# --- Geo enrichment ------------------------------------------------
# mock = deterministic, offline-safe fallback-chain proof (default, and
#        what the automated tests use). live = call the real free APIs
#        (ip-api.com, then ipapi.co) during manual development.
GEO_MODE=mock
FORCE_PROVIDER_A_DOWN=false
FORCE_PROVIDER_B_DOWN=false
GEO_TIMEOUT_MS=3000

# --- Side effects ----------------------------------------------------
FORCE_EMAIL_FAILURE=false

# --- Widget bundle ---------------------------------------------------
WIDGET_BUNDLE_VERSION=v1
PUBLIC_BASE_URL=http://localhost:3000
